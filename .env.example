SECRET_KEY=altere-esta-chave-secreta
DATABASE_URL=sqlite:///reservas.db

# E-mail 1 - ADMINISTRADOR: recebe novas solicitacoes (com botoes aprovar/recusar)
ADMIN_EMAIL=admin@escola.edu.br

# Senha para acessar a aba de Administracao no site
ADMIN_PASSWORD=admin123

# Conta SMTP usada para enviar os e-mails (geralmente a mesma conta do ADMIN_EMAIL)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=admin@escola.edu.br
MAIL_PASSWORD=sua-senha-de-app
MAIL_DEFAULT_SENDER=admin@escola.edu.br

# E-mail 2 - PROFESSOR: preenchido no formulario; recebe o feedback (aprovado/recusado)

# URL base do site (necessario para os links nos e-mails do administrador)
# Numero minimo de dias de antecedencia para solicitar uma reserva
RESERVATION_MIN_ADVANCE_DAYS=7

BASE_URL=http://127.0.0.1:5000
